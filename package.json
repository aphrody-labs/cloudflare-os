{
  "name": "cloudflare-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun scripts/vp/run.ts --filter=!cloudflare-os --cache build",
    "run-local": "bun scripts/run-local.ts",
    "test": "bun scripts/vp/run.ts --filter=!cloudflare-os --cache test",
    "evals": "bun --filter @gadgets/workshop-evals evals",
    "evals:ui": "bun --filter @gadgets/workshop-evals evals:ui",
    "preview:config": "bun scripts/preview/preview.ts config",
    "preview:deploy": "bun scripts/preview/preview.ts deploy",
    "preview:delete": "bun scripts/preview/preview.ts delete",
    "preview:sweep": "bun scripts/preview/preview.ts sweep",
    "dev-client": "bun --cwd packages/workshop-frontend run dev",
    "dev-server": "bun scripts/run-dev-server.ts",
    "clean": "bun scripts/vp/run.ts --filter=!cloudflare-os clean",
    "lint:check": "bunx vp lint",
    "lint:fix": "bunx vp lint --fix",
    "types:check": "bun run build",
    "types:scripts": "bunx tsc -p scripts/tsconfig.json",
    "lint": "bun run lint:check && bun run types:scripts && bun run configs:check && bun run types:check",
    "configs:generate": "bun scripts/generate-worker-configs.ts",
    "configs:check": "bun scripts/generate-worker-configs.ts --check",
    "types:generate": "bun scripts/generate-worker-configs.ts && bun scripts/generate-worker-types.ts",
    "api-schema:generate": "bun packages/api-schema/scripts/generate.ts"
  },
  "devDependencies": {
    "@gadgets/api-cli": "workspace:*",
    "@gadgets/scripts": "workspace:*",
    "@types/node": "26.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "@cloudflare/vitest-plugin": "^1.8.2",
      "@cloudflare/workers-types": "^5.20261113.1",
      "capnweb": "^0.12.0",
      "diff": "^9.0.0",
      "fast-check": "^4.10.2",
      "capnweb-validate": "0.3.0",
      "miniflare": "5.20261113.0-beta",
      "typescript": "7.0.2",
      "typescript6": "npm:typescript@6.0.3",
      "vite": "7.3.6",
      "vite-plus": "^1.5.1",
      "vitest": "^5.1.0",
      "@vitest/browser-playwright": "^5.1.0",
      "playwright": "^1.65.0",
      "wrangler": "^4.162.0",
      "zod": "^4.6.7"
    }
  },
  "overrides": {
    "@cloudflare/vitest-plugin>miniflare": "catalog:",
    "@cloudflare/vitest-plugin>wrangler": "catalog:",
    "vite@*": "catalog:",
    "@types/node": "26.1.0",
    "@lezer/markdown": "1.6.4",
    "@earendil-works/pi-agent-core>@earendil-works/pi-ai": "1.5.2"
  },
  "trustedDependencies": [
    "@google/genai",
    "core-js-pure",
    "esbuild",
    "protobufjs",
    "sharp",
    "workerd"
  ]
}
